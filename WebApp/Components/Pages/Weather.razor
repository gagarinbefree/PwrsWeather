@page "/"
@using Application.Dtos
@using Application.Queries
@using Application.Services
@using Domain.Entities
@using MediatR

@rendermode InteractiveServer

@inject IMediator Mediator
@inject IWeatherDataService WeatherDataService

@if (IsLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (ErrorMessage != null)
{
    <div class="row">
        <div class="col-12">
            <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    <span>@ErrorMessage</span>
                </div>
                <button class="btn btn-light btn-sm" type="button" @onclick="OnRetryClick">
                    <i class="bi bi-arrow-repeat me-1"></i> Retry
                </button>
            </div>
        </div>
    </div>
}
else if (WeatherData != null)
{
    <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
            <CurrentWeatherCard Data="@WeatherData.Current" Location="@WeatherData" />
        </div>

        <div class="col-lg-8 col-md-6 mb-4">
            <HourlyForecastCard Data="@WeatherData.HourlyForecast" />
        </div>

        <div class="col-12">
            <DailyForecastCard Data="@WeatherData.DailyForecast" />
        </div>
    </div>
}

@code {
    private WeatherData? WeatherData { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private bool Initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Initialized)
        {
            Initialized = true;
            await LoadWeather();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task OnRetryClick()
    {
        await LoadWeather();
    }

    private async Task LoadWeather()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            WeatherData = null;
            StateHasChanged();

            Console.WriteLine("Loading weather...");

            var current = await Mediator.Send(new GetCurrentWeatherQuery());
            var forecast = await Mediator.Send(new GetForecastQuery());

            WeatherData = WeatherDataService.MapToWeatherData(current, forecast);

            Console.WriteLine("Weather loaded successfully");
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = "Failed to connect to weather service. Please check your internet connection.";
            Console.WriteLine($"HttpRequestException: {ex.Message}");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Exception: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}