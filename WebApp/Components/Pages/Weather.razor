@page "/"
@using Application.Queries
@using Domain.Entities
@using MediatR

@attribute [StreamRendering]

@inject IMediator Mediator

<div class="row">
    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="col-12">
            <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    <span>@ErrorMessage</span>
                </div>
                <button class="btn btn-light btn-sm" @onclick="LoadWeather">
                    <i class="bi bi-arrow-repeat me-1"></i> Retry
                </button>
            </div>
        </div>
    }
    else if (WeatherData != null)
    {
        <!-- Current Weather -->
        <div class="col-lg-4 col-md-6 mb-4">
            <CurrentWeatherCard Data="@WeatherData.Current" Location="@WeatherData" />
        </div>

        <!-- Hourly Forecast -->
        <div class="col-lg-8 col-md-6 mb-4">
            <HourlyForecastCard Data="@WeatherData.HourlyForecast" />
        </div>

        <!-- Daily Forecast -->
        <div class="col-12">
            <DailyForecastCard Data="@WeatherData.DailyForecast" />
        </div>
    }
</div>

@code {
    private WeatherData? WeatherData { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    // Москва
    private const double Latitude = 55.7558;
    private const double Longitude = 37.6173;

    protected override async Task OnInitializedAsync()
    {
        await LoadWeather();
    }

    private async Task LoadWeather()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            StateHasChanged();

            WeatherData = await Mediator.Send(new GetWeatherQuery(Latitude, Longitude));
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Failed to connect to weather service. Please check your internet connection.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}